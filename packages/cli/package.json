{
  "name": "arenacode-cli",
  "version": "1.0.0",
  "description": "ArenaCode terminal client for agentic AI chat and tool execution.",
  "keywords": [
    "arenacode",
    "cli",
    "terminal",
    "ai",
    "chat",
    "bun",
    "tui"
  ],
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "arenacode": "bin/arenacode"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.186",
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "ai": "^6.0.184",
    "date-fns": "^4.1.0",
    "hono": "^4.12.12",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.6",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.4",
    "react-router": "^7.14.0",
    "zod": "^4.3.6"
  }
}